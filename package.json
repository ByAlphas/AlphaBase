{
  "name": "alphabase",
  "version": "4.0.0",
  "description": "Lightweight embedded TypeScript database with advanced querying, streaming, monitoring, and validation features for single-process Node.js applications. Validated up to 250K records with near-linear scaling.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "cli.js",
    "cli-advanced.js",
    "README.md",
    "LICENSE",
    "MIGRATION.md",
    "CHANGELOG.md",
    "KNOWN_ISSUES.md",
    "PERFORMANCE.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html lcov text",
    "test:verbose": "jest --verbose",
    "lint": "eslint . --ext .js,.ts --ignore-pattern 'tests/*' --ignore-pattern 'node_modules/*' --ignore-pattern 'dist/*'",
    "type-check": "tsc --noEmit",
    "server": "node server.js",
    "cli": "node cli.js",
    "cli:advanced": "node cli-advanced.js",
    "benchmark": "node benchmark.js",
    "benchmark:easy": "node benchmark.js easy",
    "benchmark:medium": "node benchmark.js medium",
    "benchmark:hard": "node benchmark.js hard",
    "benchmark:all": "node benchmark.js all",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "database",
    "typescript",
    "key-value",
    "json",
    "file-based",
    "embedded-database",
    "query-engine",
    "streaming",
    "monitoring",
    "metrics",
    "health-checks",
    "indexing",
    "cache",
    "lru",
    "soft-delete",
    "event-emitter",
    "zero-dependency",
    "lightweight",
    "validation",
    "transactions",
    "ttl",
    "backup",
    "jwt-authentication",
    "rsa-encryption",
    "encryption",
    "audit-logging",
    "rest-api",
    "https",
    "rate-limiting",
    "http-server",
    "performance",
    "caching",
    "connection-pool",
    "nodejs-database"
  ],
  "author": {
    "name": "ByAlphas",
    "url": "https://github.com/ByAlphas/alphabase"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByAlphas/alphabase.git"
  },
  "bugs": {
    "url": "https://github.com/ByAlphas/alphabase/issues"
  },
  "homepage": "https://github.com/ByAlphas/alphabase#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.0.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "express": ">=4.0.0 || >=5.0.0",
    "express-rate-limit": ">=7.0.0",
    "jsonwebtoken": ">=9.0.0",
    "crypto-js": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    },
    "crypto-js": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@picocss/pico": "^2.1.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^12.0.0",
    "yargs": "^18.0.0"
  }
}
